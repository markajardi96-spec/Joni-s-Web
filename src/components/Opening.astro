---
import { sq } from '../data/content.js';
---
<section class="opening" id="top">
  <div class="film" id="film" aria-hidden="true"><div id="filmPlayer"></div></div>

  <button class="sound" id="soundToggle" type="button" aria-pressed="false" hidden>
    <span class="sound-icon" aria-hidden="true"></span>
    <span class="sound-label" data-i18n="film.on">{sq['film.on']}</span>
  </button>

  <div class="opening-inner">
    <h1 class="name"><span>Jonuz</span><span>Markaj</span></h1>
    <p class="role" data-i18n="hero.role">{sq['hero.role']}</p>
    <p class="opening-line" data-i18n="hero.note">{sq['hero.note']}</p>
    <div class="opening-actions">
      <a class="btn btn-solid" href="#contact" data-i18n="hero.cta1">{sq['hero.cta1']}</a>
      <a class="btn btn-quiet" href="#recordings" data-i18n="hero.cta2">{sq['hero.cta2']}</a>
    </div>
    <p class="film-caption" data-i18n="hero.caption">{sq['hero.caption']}</p>
  </div>
</section>
