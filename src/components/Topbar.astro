---
import { sq } from '../data/content.js';

const links = [
  { href: '#note',        key: 'nav.about' },
  { href: '#events',      key: 'nav.services' },
  { href: '#recordings',  key: 'nav.videos' },
  { href: '#repertoire',  key: 'nav.repertoire' },
];
---
<header class="topbar" id="topbar">
  <a class="topbar-name" href="#top">
    {/* Three keys — the mark is the instrument, not a generic waveform. */}
    <svg class="keys" width="18" height="20" viewBox="0 0 18 20" fill="none" aria-hidden="true">
      <rect x=".75" y=".75" width="16.5" height="18.5" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M6.5 1v12M11.5 1v12" stroke="currentColor" stroke-width="1.5"/>
    </svg>
    Jonuz Markaj
  </a>

  <nav class="topbar-nav" aria-label="Seksionet">
    {links.map((l) => (
      <a href={l.href} data-i18n={l.key}>{sq[l.key]}</a>
    ))}
  </nav>

  <div class="topbar-side">
    <a class="topbar-book" href="#contact" data-i18n="nav.book">{sq['nav.book']}</a>
    <button class="lang" id="langToggle" type="button" aria-label="Change language">English</button>
    <button
      class="menu-btn"
      id="menuToggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Menu"
    ><span></span></button>
  </div>
</header>

<nav class="menu" id="menu" aria-label="Menu" hidden>
  {links.map((l) => (
    <a href={l.href} data-i18n={l.key}>{sq[l.key]}</a>
  ))}
  <a class="menu-book" href="#contact" data-i18n="nav.book">{sq['nav.book']}</a>
</nav>
